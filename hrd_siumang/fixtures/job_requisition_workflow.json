                {
                    "role": "Employee"
                }
            ]
        },
        {
            "action": "Approve",
            "state": "Pending Manager Approval",
            "next_state": "Approved",
            "condition": "doc.jenis_permintaan != \"Tambahan\"",
            "allowed_roles": [
                {
                    "role": "Manager"
                }
            ]
        },
        {
            "action": "Approve",
            "state": "Pending Manager Approval",
            "next_state": "Pending Director Approval",
            "condition": "doc.jenis_permintaan == \"Tambahan\"",
            "allowed_roles": [
                {
                    "role": "Manager"
                }
            ]
        },
        {
            "action": "Approve",
            "state": "Pending Director Approval",
            "next_state": "Approved",
            "allowed_roles": [
                {
                    "role": "Director"
                }
            ]
        },
        {
            "action": "Reject",
            "state": "Pending Manager Approval",
            "next_state": "Rejected",
            "allowed_roles": [
                {
                    "role": "Manager"
                }
            ]
        },
        {
            "action": "Reject",
            "state": "Pending Director Approval",
            "next_state": "Rejected",
            "allowed_roles": [
                {
                    "role": "Director"
                }
            ]
        }
    ]
